<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aushang: Partien analysieren mit goteach</title>
<meta name="robots" content="index, follow">
<meta name="description" content="Blatt zum Ausdrucken und Aufhängen: eigene Go-Partie hochladen und für jeden Zug eine deutsche Lehreinheit zurückbekommen.">
<style>
/* Ein Blatt, zwei Auftritte: am Bildschirm eine gewöhnliche Seite, im
   Druck ein A3-Bogen. Alle Maße stehen in em, deshalb genügt es, die
   Grundschrift umzuschalten — das Verhältnis der Teile bleibt gleich. */

:root {
  --paper: #f7f5f0;
  --card: #fffefb;
  --ink: #211f1a;
  --muted: #6f695e;
  --border: #e6e1d5;
  --accent: #8a5f18;
  --rule: #211f1a;
}

* { box-sizing: border-box; }

html { color-scheme: light; }

body {
  margin: 0;
  background: #e9e6df;
  color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
  -webkit-text-size-adjust: 100%;
}

.sheet {
  background: var(--paper);
  width: min(100%, 46em);
  margin: 0 auto;
  padding: 2.2em 1.4em 2.4em;
  font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
}

/* ---------- Kopf ---------- */

.head {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 1.6em;
  align-items: start;
}

/* ---------- Das Brett der Vereinsseite ----------
   Übernommen aus flascheleer-berlin.de (view/goban.rs und die gb-Regeln
   der styles.css), damit Mitglieder dieselbe Zeichnung wiedererkennen.
   Zwei Abweichungen: Dort liegt eine Holzfotografie über der Fläche, hier
   bleibt es bei der Farbe, denn das Blatt lädt nichts nach. Und der
   Koordinatenring steht weiter außen (1.3 statt 0.85 Brettweiten), sonst
   verschwinden die zweistelligen Zahlen unter den Steinen auf der A- und
   der N-Linie. */

.board { margin: 0; }
.board svg { display: block; width: 100%; height: auto; }

.board figcaption {
  font-size: 0.72em;
  line-height: 1.4;
  color: var(--muted);
  margin-top: 0.5em;
}

.gb-wood { fill: #c99f4a; }
.gb-line { stroke: #33220a; stroke-width: .045; }
.gb-hoshi { fill: #33220a; }
.gb-stone.gb-black { fill: url(#gb-slate); stroke: #000; stroke-width: .025; stroke-opacity: .55; }
.gb-stone.gb-white { fill: url(#gb-shell); stroke: #8d8371; stroke-width: .02; stroke-opacity: .5; }
.gb-label { fill: #33220a; font-size: .42px; text-anchor: middle; dominant-baseline: central; opacity: .75; }
.gb-mark { fill: none; stroke-width: .07; }
.gb-mark-on-black { stroke: #f4efe6; }
.gb-mark-on-white { stroke: #181818; }

.club {
  margin: 0 0 0.4em;
  font-size: 0.72em;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
}

.mark {
  display: flex;
  align-items: center;
  gap: 0.4em;
  font-size: 1.5em;
  font-weight: 600;
  letter-spacing: 0.01em;
  margin: 0 0 0.7em;
}

.stone {
  display: inline-block;
  width: 0.62em;
  height: 0.62em;
  border-radius: 50%;
  flex: none;
}

.stone-black { background: radial-gradient(circle at 35% 30%, #4a4a4a, #0a0a0a); }
.stone-white {
  background: radial-gradient(circle at 35% 30%, #fff, #d8d2c4);
  border: 1px solid #b9b2a2;
}

h1 {
  font-size: 2.6em;
  line-height: 1.06;
  letter-spacing: -0.015em;
  font-weight: 700;
  margin: 0 0 0.35em;
}

.lead {
  font-size: 1.08em;
  line-height: 1.45;
  margin: 0 0 1.4em;
  max-width: 30em;
}

.lead strong { font-weight: 600; }

hr {
  border: 0;
  border-top: 0.14em solid var(--rule);
  margin: 0 0 1.4em;
}

/* ---------- Drei Schritte ---------- */

.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.2em;
  margin: 0 0 1.6em;
}

.step { border-top: 0.09em solid var(--ink); padding-top: 0.6em; }

.step .no {
  font-size: 1.6em;
  font-weight: 700;
  line-height: 1;
  display: block;
  margin-bottom: 0.2em;
}

.step h2 {
  font-size: 1em;
  font-weight: 600;
  margin: 0 0 0.25em;
}

.step p { margin: 0; font-size: 0.86em; line-height: 1.45; color: var(--muted); }

.step .url { color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }

/* ---------- Zwei Spalten: Inhalt und Herkunft ---------- */

.columns {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 1.4em;
  margin: 0 0 1.6em;
}

.columns h2 {
  font-size: 0.72em;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 0.6em;
  font-weight: 600;
}

.columns ul { margin: 0; padding: 0; list-style: none; }

.columns li {
  font-size: 0.9em;
  line-height: 1.4;
  padding: 0 0 0.45em 0.95em;
  position: relative;
}

.columns li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.5em;
  width: 0.32em;
  height: 0.32em;
  background: var(--accent);
}

.columns li b { font-weight: 600; }

/* ---------- QR-Block ---------- */

.qr {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 1.2em;
  align-items: center;
  background: var(--card);
  border: 0.09em solid var(--border);
  padding: 1em 1.1em;
  margin: 0 0 1.2em;
}

.qr svg { display: block; }
.qr .big svg { width: 9em; height: 9em; }
.qr .small svg { width: 5.2em; height: 5.2em; }

.qr .big { text-align: center; }
.qr .small { text-align: center; }

.qr .caption {
  font-size: 0.68em;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0.4em 0 0;
}

.qr .pitch { align-self: center; }
.qr .pitch p { margin: 0 0 0.3em; }
.qr .pitch .big-url {
  font-size: 1.25em;
  font-weight: 700;
  overflow-wrap: anywhere;
  line-height: 1.2;
}
.qr .pitch .note { font-size: 0.85em; color: var(--muted); margin: 0; }

/* ---------- Hinweise ---------- */

.warn {
  border: 0.09em solid #dcc084;
  background: #faf0da;
  padding: 0.7em 0.9em;
  font-size: 0.85em;
  margin: 0 0 1.2em;
}

footer {
  border-top: 0.09em solid var(--border);
  padding-top: 0.7em;
  font-size: 0.76em;
  line-height: 1.45;
  color: var(--muted);
}

footer b { color: var(--ink); font-weight: 600; }

a { color: inherit; }

/* ---------- Schmaler Bildschirm ----------
   Am Handy wird das Blatt gelesen, nicht gedruckt: Die Spalten stapeln
   sich, damit die Adresse nicht Buchstabe für Buchstabe umbricht. Der
   Druckbogen bleibt davon unberührt, weil die Regel nur für screen gilt. */

@media screen and (max-width: 34em) {
  .head,
  .steps,
  .columns,
  .qr {
    grid-template-columns: 1fr;
    gap: 1.1em;
  }

  .step { padding-top: 0.4em; }

  .qr { justify-items: center; text-align: center; }
  .qr .big svg { width: 11em; height: 11em; }
  .qr .small svg { width: 6em; height: 6em; }
  .qr .pitch { text-align: center; }
}

/* ---------- Druck: ein A3-Bogen ---------- */

@page { size: A3 portrait; margin: 0; }

@media print {
  body { background: #fff; }

  .sheet {
    /* 5mm Grundschrift: 297mm ≙ 59.4em Breite, 420mm ≙ 84em Höhe. Ein
       Blatt an der Wand wird aus zwei Metern gelesen, nicht aus fünfzig
       Zentimetern — die Schrift ist deshalb deutlich größer als am
       Bildschirm. Nach oben ist wenig Luft: Ab etwa 5.3mm läuft der Bogen
       auf eine zweite Seite über, und zwar zuerst dann, wenn der Hinweis
       auf die fehlende Engine mitgedruckt wird. */
    font-size: 5mm;
    width: 297mm;
    height: 420mm;
    padding: 15mm 16mm 12mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #fff;
  }

  /* Die Abstände zwischen den Abschnitten verteilt space-between; die
     eigenen Außenabstände fallen dafür weg. */
  header, .steps, .columns, .qr, .warn { margin-bottom: 0; }
  .board svg { max-height: 20em; margin-left: auto; }

  h1 { font-size: 3.3em; }
  .lead { font-size: 1.15em; max-width: 34em; }

  .qr .big svg { width: 12em; height: 12em; }
  .qr .small svg { width: 6.4em; height: 6.4em; }

  a { text-decoration: none; }
}
</style>
</head>
