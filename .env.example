# Kopieren nach .env — NIEMALS committen (.env steht in .gitignore).

# Optionaler LLM-Feinschliff (-llm).
ANTHROPIC_API_KEY=sk-ant-IhrKeyHier

# --- Authentifizierung (JWT) — optional -------------------------------
# Ohne AUTH_USERS läuft der Dienst offen (POST /analyze ohne Login).
# Hashes erzeugen: echo -n 'geheim' | go run ./cmd/passhash
# AUTH_USERS=alice:pbkdf2-sha256$600000$…$…,bob:pbkdf2-sha256$600000$…$…
# AUTH_JWT_SECRET=langes-zufaelliges-secret
# AUTH_TOKEN_TTL=24h

# --- Remote-Engine — optional -----------------------------------------
# Instanz OHNE Engine: Analysen an den Docker-Host
# delegieren. KATAGO_REMOTE_TOKEN muss dem KATAGO_ENGINE_TOKEN des
# Hosts entsprechen.
# KATAGO_REMOTE_URL=https://goteach.example.com
# KATAGO_REMOTE_TOKEN=gemeinsames-secret

# Instanz MIT Engine (Docker-Host): Passthrough POST /engine/analyze
# freischalten. Ohne diese Variable existiert die Route nicht.
# KATAGO_ENGINE_TOKEN=gemeinsames-secret

# KataGo-Tuning ohne Rebuild ("schlüssel=wert,…" → -override-config).
# Die analysis.cfg ist bewusst konservativ für kleine Cloud-Container;
# auf dicker Hardware hochdrehen (Faustregel: Suchthreads ≈ vCPUs − 1).
# KATAGO_OVERRIDES=numSearchThreadsPerAnalysisThread=16,nnMaxBatchSize=32
